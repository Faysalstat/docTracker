# Copy to infra/.env and change the passwords.
MONGO_PORT=27017

# Root user (admin only, never used by the app)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-root

# Application database and least-privilege user (used in api/.env MONGODB_URI)
MONGO_APP_DATABASE=doctor-tracker
MONGO_APP_USERNAME=doctor_tracker_app
MONGO_APP_PASSWORD=change-me-app
