{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "nodemon app.ts",
    "dev": "nodemon app.ts",
    "build": "tsc -p tsconfig.build.json",
    "serve": "node dist/app.js",
    "serve:prod": "node --env-file=.env.production dist/app.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:prod": "tsx --env-file=.env.production scripts/seed.ts",
    "migrate:rules-alignment": "tsx scripts/migrate-rules-alignment.ts",
    "sync-indexes": "tsx scripts/sync-indexes.ts",
    "sync-indexes:prod": "tsx --env-file=.env.production scripts/sync-indexes.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.8",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
