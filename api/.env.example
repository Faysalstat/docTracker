NODE_ENV=development
SERVER_PORT=4000

# Use the app user from infra/.env (MONGO_APP_USERNAME / MONGO_APP_PASSWORD)
MONGO_URI=mongodb://doctor_tracker_app:change-me-app@localhost:27017/doctor-tracker?authSource=doctor-tracker

# Generate with: openssl rand -base64 32  (must match JWT_SECRET in web/.env.local)
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h

# Comma-separated browser origins allowed to call the API directly. Empty: none
# (the web app calls the API server-to-server).
CORS_ORIGIN=

# Admin account created by `npm run seed`
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=ChangeMe@123
